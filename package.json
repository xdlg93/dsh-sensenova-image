{
  "name": "dsh-sensenova-image",
  "version": "0.2.2",
  "private": false,
  "description": "SenseNova U1.5 Lite/Fast text-to-image tool and settings page for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "dsh": "^0.2.2-rc.5 || ^0.2.3-alpha.2"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sensenova",
    "text-to-image",
    "image-generation"
  ],
  "author": "xdlg93",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xdlg93/dsh-sensenova-image.git"
  },
  "homepage": "https://github.com/xdlg93/dsh-sensenova-image#readme",
  "bugs": {
    "url": "https://github.com/xdlg93/dsh-sensenova-image/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
